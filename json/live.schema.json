{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trailboss --json live",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "agent": {
        "type": [
          "null",
          "string"
        ]
      },
      "cost_usd": {
        "type": [
          "null",
          "number"
        ]
      },
      "cwd": {
        "type": [
          "null",
          "string"
        ]
      },
      "host": {
        "type": [
          "null",
          "string"
        ]
      },
      "needs": {
        "description": "Why the agent waits on you, in a few words (\"Plan to approve\", a question's first words, \"Run: npm test\", \"Rate limited\"); null when it doesn't.",
        "type": [
          "null",
          "string"
        ]
      },
      "needs_kind": {
        "description": "What kind of request `needs` is, with nothing from the transcript: plan, question, run, edit, read, fetch, search, tool, rate_limit, error or waiting (more may be added).",
        "type": [
          "null",
          "string"
        ]
      },
      "parent": {
        "type": "string"
      },
      "pid": {
        "type": [
          "integer",
          "null"
        ]
      },
      "quiet_min": {
        "type": "null"
      },
      "reported_cost_usd": {
        "type": [
          "null",
          "number"
        ]
      },
      "session": {
        "type": [
          "null",
          "string"
        ]
      },
      "shares_with": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "status": {
        "type": "string"
      },
      "stuck": {
        "type": "boolean"
      },
      "terminal": {
        "type": [
          "null",
          "string"
        ]
      },
      "title": {
        "type": [
          "null",
          "string"
        ]
      },
      "tokens": {
        "type": [
          "integer",
          "null"
        ]
      },
      "turn": {
        "description": "The turn under way, or the last one finished, counted from the transcript; null without one.",
        "type": [
          "integer",
          "null"
        ]
      },
      "turn_ended_ms": {
        "description": "When that turn ended, in ms since the epoch; null while it's under way or unknown.",
        "type": [
          "integer",
          "null"
        ]
      },
      "where": {
        "type": "string"
      },
      "workspace": {
        "type": "string"
      }
    },
    "required": [
      "host",
      "status",
      "terminal",
      "where"
    ]
  }
}
