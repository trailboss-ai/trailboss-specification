    "properties": {
      "agent": {
        "type": "string"
      },
      "cwd": {
        "type": "string"
      },
      "edits": {
        "type": "integer"
      },
      "files": {
        "type": "integer"
      },
      "last": {
        "type": "string"
      },
      "session": {
        "type": "string"
      },
      "title": {
        "type": [
